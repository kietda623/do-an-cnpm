# Copy to .env.test and fill the password yourself. This database is reset by integration tests.
# Use a dedicated PostgreSQL database; never point this at your app database.
# URL-encode reserved password characters, such as @ as %40.
# The signing/HMAC keys below are test-only examples; never use them outside local tests.
# Broad domain integrations share localhost IP buckets, so raise all caps here. Policy defaults
# are asserted in unit tests; the dedicated Redis integration suite sets its own small cap.
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/cnpm_test?schema=public
TEST_DATABASE_NAME_CONFIRMATION=cnpm_test
NODE_ENV=test
JWT_SIGNING_SECRET=test-only-signing-secret-do-not-use-outside-tests
RATE_LIMIT_REDIS_URL=redis://localhost:56380
RATE_LIMIT_KEY_SECRET=test-only-rate-limit-secret-do-not-use-outside-tests
RATE_LIMIT_KEY_PREFIX=marketplace-test
API_TRUST_PROXY_HOPS=0
RATE_LIMIT_REGISTER_EMAIL_PER_MINUTE=10000
RATE_LIMIT_REGISTER_IP_PER_MINUTE=10000
RATE_LIMIT_LOGIN_EMAIL_PER_MINUTE=10000
RATE_LIMIT_LOGIN_IP_PER_MINUTE=10000
RATE_LIMIT_REFRESH_FAMILY_PER_MINUTE=10000
RATE_LIMIT_REFRESH_IP_PER_MINUTE=10000
