{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "build/**", "out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "TEST_DATABASE_NAME_CONFIRMATION",
        "NODE_ENV",
        "JWT_SIGNING_SECRET",
        "RATE_LIMIT_REDIS_URL",
        "RATE_LIMIT_KEY_SECRET",
        "RATE_LIMIT_KEY_PREFIX",
        "API_TRUST_PROXY_HOPS",
        "RATE_LIMIT_REGISTER_EMAIL_PER_MINUTE",
        "RATE_LIMIT_REGISTER_IP_PER_MINUTE",
        "RATE_LIMIT_LOGIN_EMAIL_PER_MINUTE",
        "RATE_LIMIT_LOGIN_IP_PER_MINUTE",
        "RATE_LIMIT_REFRESH_FAMILY_PER_MINUTE",
        "RATE_LIMIT_REFRESH_IP_PER_MINUTE"
      ],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
