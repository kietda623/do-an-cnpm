# Copy to .env.compose, change all placeholder secrets, then pass with --env-file.
# Keep POSTGRES_PASSWORD alphanumeric so these PostgreSQL URLs need no encoding.
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=replace_with_a_long_local_only_password
JWT_SIGNING_SECRET=replace_with_a_random_local_signing_secret_at_least_32_chars
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_READ_BASE=
