# Copy to .env.compose, change all placeholder secrets, then pass with --env-file.
# Keep POSTGRES_PASSWORD alphanumeric so these PostgreSQL URLs need no encoding.
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=replace_with_a_long_local_only_password
JWT_SIGNING_SECRET=replace_with_a_random_local_signing_secret_at_least_32_chars
RATE_LIMIT_KEY_SECRET=replace_with_a_separate_random_secret_at_least_32_chars
RATE_LIMIT_KEY_PREFIX=marketplace-local
RATE_LIMIT_REDIS_URL=redis://redis:6379
API_TRUST_PROXY_HOPS=0
RATE_LIMIT_REGISTER_EMAIL_PER_MINUTE=5
RATE_LIMIT_REGISTER_IP_PER_MINUTE=60
RATE_LIMIT_LOGIN_EMAIL_PER_MINUTE=10
RATE_LIMIT_LOGIN_IP_PER_MINUTE=180
RATE_LIMIT_REFRESH_FAMILY_PER_MINUTE=30
RATE_LIMIT_REFRESH_IP_PER_MINUTE=300
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_READ_BASE=
