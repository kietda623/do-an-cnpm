generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IdempotencyState {
  IN_PROGRESS
  COMPLETED

  @@map("idempotency_state")
}

enum SystemRole {
  BUYER
  ADMIN

  @@map("system_role")
}

enum UserStatus {
  ACTIVE
  LOCKED

  @@map("user_status")
}

enum SessionPlatform {
  WEB
  MOBILE
  DESKTOP

  @@map("session_platform")
}

enum ClientPlatform {
  WEB
  ANDROID
  IOS
  WINDOWS
  MACOS

  @@map("client_platform")
}

enum AssetPurpose {
  AVATAR
  SHOP_LOGO
  SHOP_BANNER
  PRODUCT_IMAGE

  @@map("asset_purpose")
}

enum AssetStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("asset_status")
}

enum ShopStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED

  @@map("shop_status")
}

enum ShopMemberRole {
  OWNER
  MANAGER

  @@map("shop_member_role")
}

enum ShopMemberStatus {
  ACTIVE
  REVOKED

  @@map("shop_member_status")
}

enum CategoryStatus {
  VISIBLE
  HIDDEN

  @@map("category_status")
}

enum ProductSaleStatus {
  DRAFT
  ACTIVE
  DISCONTINUED

  @@map("product_sale_status")
}

enum VariantSaleStatus {
  ACTIVE
  DISCONTINUED

  @@map("variant_sale_status")
}

enum InventoryMovementKind {
  INITIAL
  ADJUST
  SALE
  CANCEL_RETURN
  CONFIRMED_RETURN

  @@map("inventory_movement_kind")
}

enum InventoryEffectType {
  SALE
  RESTORE

  @@map("inventory_effect_type")
}

enum PaymentMethod {
  COD
  MOCK

  @@map("payment_method")
}

enum PaymentProvider {
  MOCK
  COD_SIMULATION

  @@map("payment_provider")
}

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED

  @@map("payment_attempt_status")
}

enum PaymentSettlementKind {
  NORMAL
  LATE_COMPENSATION

  @@map("payment_settlement_kind")
}

enum PaymentAllocationKind {
  MOCK_PREPAYMENT
  COD_COLLECTION

  @@map("payment_allocation_kind")
}

enum PaymentEventResult {
  APPLIED
  DUPLICATE
  IGNORED
  REFUNDED

  @@map("payment_event_result")
}

enum PaymentObservedStatus {
  SUCCEEDED
  FAILED
  CANCELLED

  @@map("payment_observed_status")
}

enum SimulatedRefundReason {
  CANCELLATION
  LATE_SUCCESS
  CONFIRMED_RETURN

  @@map("simulated_refund_reason")
}

enum MarketplaceOrderStatus {
  PENDING
  CONFIRMED
  PACKING
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED

  @@map("marketplace_order_status")
}

enum SellerOrderStatus {
  PENDING
  CONFIRMED
  PACKING
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED

  @@map("seller_order_status")
}

model User {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emailNormalized    String              @unique(map: "users_email_normalized_key") @map("email_normalized") @db.VarChar(254)
  passwordHash       String              @map("password_hash") @db.Text
  displayName        String              @map("display_name") @db.VarChar(120)
  phone              String?             @db.VarChar(20)
  avatarAssetId      String?             @map("avatar_asset_id") @db.Uuid
  systemRole         SystemRole          @default(BUYER) @map("system_role")
  status             UserStatus          @default(ACTIVE)
  authVersion        Int                 @default(0) @map("auth_version")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions           Session[]
  addresses          Address[]
  avatarAsset        Asset?              @relation("UserAvatar", fields: [avatarAssetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  uploadedAssets     Asset[]             @relation("AssetUploader")
  ownedShops         Shop[]              @relation("ShopOwner")
  shopMemberships    ShopMember[]
  auditEvents        AuditEvent[]
  idempotencyRows    IdempotencyRecord[]
  inventoryMovements InventoryMovement[]
  orderEvents        OrderEvent[]
  cart               Cart?
  checkoutQuotes     CheckoutQuote[]
  marketplaceOrders  MarketplaceOrder[]

  @@index([status, createdAt, id], map: "users_status_created_at_id_idx")
  @@map("users")
}

model Session {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String          @map("user_id") @db.Uuid
  user                User            @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  platform            SessionPlatform
  clientPlatform      ClientPlatform  @map("client_platform")
  refreshHash         String          @unique(map: "sessions_refresh_hash_key") @map("refresh_hash") @db.Text
  familyId            String          @map("family_id") @db.Uuid
  expiresAt           DateTime        @map("expires_at") @db.Timestamptz(6)
  revokedAt           DateTime?       @map("revoked_at") @db.Timestamptz(6)
  replacedBySessionId String?         @unique(map: "sessions_replaced_by_session_id_key") @map("replaced_by_session_id") @db.Uuid
  replacedBySession   Session?        @relation("SessionRotation", fields: [replacedBySessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  replacesSession     Session?        @relation("SessionRotation")
  lastSeenAt          DateTime        @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, revokedAt], map: "sessions_user_id_revoked_at_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@index([familyId], map: "sessions_family_id_idx")
  @@map("sessions")
}

model Address {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recipientName String    @map("recipient_name") @db.VarChar(120)
  phone         String    @db.VarChar(20)
  line1         String    @db.VarChar(250)
  ward          String    @db.VarChar(120)
  district      String    @db.VarChar(120)
  province      String    @db.VarChar(120)
  country       String    @default("VN") @db.Char(2)
  postalCode    String?   @map("postal_code") @db.VarChar(20)
  isDefault     Boolean   @default(false) @map("is_default")
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  checkoutQuotes CheckoutQuote[]

  @@index([userId, deletedAt], map: "addresses_user_id_deleted_at_idx")
  @@map("addresses")
}

model Asset {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploaderUserId String         @map("uploader_user_id") @db.Uuid
  uploaderUser   User           @relation("AssetUploader", fields: [uploaderUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  shopId         String?        @map("shop_id") @db.Uuid
  purpose        AssetPurpose
  objectKey      String         @unique(map: "assets_object_key_key") @map("object_key") @db.Text
  mimeType       String         @map("mime_type") @db.VarChar(100)
  byteSize       Int            @map("byte_size")
  width          Int
  height         Int
  status         AssetStatus    @default(PENDING)
  attachedAt     DateTime?      @map("attached_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  avatarForUsers User[]         @relation("UserAvatar")
  shop           Shop?          @relation("ShopAssets", fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  logoForShop    Shop?          @relation("ShopLogo")
  bannerForShop  Shop?          @relation("ShopBanner")
  productImages  ProductImage[]
  orderItemImages OrderItem[]

  @@index([uploaderUserId, status, createdAt, id], map: "assets_uploader_status_created_at_id_idx")
  @@index([shopId, purpose, status, id], map: "assets_shop_purpose_status_id_idx")
  @@map("assets")
}

model AuditEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  actorUser    User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorKind    String   @map("actor_kind") @db.Text
  action       String   @db.Text
  targetType   String   @map("target_type") @db.Text
  targetId     String   @map("target_id") @db.Uuid
  shopId       String?  @map("shop_id") @db.Uuid
  shop         Shop?    @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reason       String?  @db.Text
  outcome      String   @db.Text
  requestId    String   @map("request_id") @db.Uuid
  safeMetadata Json     @default("{}") @map("safe_metadata") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([targetType, targetId, createdAt, id])
  @@index([actorUserId, createdAt, id])
  @@index([requestId])
  @@map("audit_events")
}

model IdempotencyRecord {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId     String?          @map("actor_user_id") @db.Uuid
  actorUser       User?            @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorScope      String           @map("actor_scope") @db.Text
  operation       String           @db.Text
  idempotencyKey  String           @map("idempotency_key") @db.VarChar(128)
  requestHash     String           @map("request_hash") @db.Char(64)
  state           IdempotencyState @default(IN_PROGRESS)
  responseStatus  Int?             @map("response_status")
  resourceType    String?          @map("resource_type") @db.Text
  resourceId      String?          @map("resource_id") @db.Uuid
  responseSummary Json?            @map("response_summary") @db.JsonB
  expiresAt       DateTime?        @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([actorScope, operation, idempotencyKey])
  @@index([expiresAt])
  @@index([actorUserId, createdAt, id])
  @@map("idempotency_records")
}

model Shop {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId        String              @map("owner_user_id") @db.Uuid
  owner              User                @relation("ShopOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  name               String              @db.VarChar(150)
  slugNormalized     String              @unique(map: "shops_slug_normalized_key") @map("slug_normalized") @db.VarChar(80)
  description        String              @db.Text
  logoAssetId        String              @unique(map: "shops_logo_asset_id_key") @map("logo_asset_id") @db.Uuid
  logo               Asset               @relation("ShopLogo", fields: [logoAssetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bannerAssetId      String?             @unique(map: "shops_banner_asset_id_key") @map("banner_asset_id") @db.Uuid
  banner             Asset?              @relation("ShopBanner", fields: [bannerAssetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assets             Asset[]             @relation("ShopAssets")
  contactAddress     String              @map("contact_address") @db.VarChar(500)
  phone              String              @db.VarChar(20)
  status             ShopStatus          @default(PENDING)
  decisionReason     String?             @map("decision_reason") @db.VarChar(500)
  approvedAt         DateTime?           @map("approved_at") @db.Timestamptz(6)
  version            Int                 @default(0)
  members            ShopMember[]
  auditEvents        AuditEvent[]
  products           Product[]
  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  sellerOrders       SellerOrder[]
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt, id], map: "shops_status_created_at_id_idx")
  @@map("shops")
}

model ShopMember {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId    String           @map("shop_id") @db.Uuid
  shop      Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role      ShopMemberRole
  status    ShopMemberStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([shopId, userId], map: "shop_members_shop_id_user_id_key")
  @@index([userId, status, shopId], map: "shop_members_user_id_status_shop_id_idx")
  @@map("shop_members")
}

model Category {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId  String?        @map("parent_id") @db.Uuid
  parent    Category?      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children  Category[]     @relation("CategoryTree")
  name      String         @db.VarChar(120)
  slug      String         @unique(map: "categories_slug_key") @db.VarChar(160)
  status    CategoryStatus @default(VISIBLE)
  version   Int            @default(0)
  products  Product[]
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([parentId, status, id], map: "categories_parent_status_id_idx")
  @@map("categories")
}

model Product {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId       String            @map("shop_id") @db.Uuid
  shop         Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  categoryId   String            @map("category_id") @db.Uuid
  category     Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  name         String            @db.VarChar(200)
  description  String            @db.Text
  saleStatus   ProductSaleStatus @default(DRAFT) @map("sale_status")
  adminHidden  Boolean           @default(false) @map("admin_hidden")
  hiddenReason String?           @map("hidden_reason") @db.VarChar(500)
  version      Int               @default(0)
  images       ProductImage[]
  variants     ProductVariant[]
  orderItems   OrderItem[]
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([id, shopId], map: "products_id_shop_id_key")
  @@index([shopId, saleStatus, createdAt, id], map: "products_shop_status_created_id_idx")
  @@index([categoryId, saleStatus, createdAt, id], map: "products_category_status_created_id_idx")
  @@map("products")
}

model ProductImage {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assetId   String  @map("asset_id") @db.Uuid
  asset     Asset   @relation(fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  position  Int

  @@unique([productId, position], map: "product_images_product_position_key")
  @@unique([productId, assetId], map: "product_images_product_asset_key")
  @@map("product_images")
}

model ProductVariant {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String            @map("product_id") @db.Uuid
  shopId        String            @map("shop_id") @db.Uuid
  product       Product           @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Restrict, onUpdate: Cascade)
  skuNormalized String            @map("sku_normalized") @db.VarChar(100)
  attributes    Json              @default("{}") @db.JsonB
  attributesKey String            @map("attributes_key") @db.Text
  price         Decimal           @db.Decimal(18, 0)
  saleStatus    VariantSaleStatus @default(ACTIVE) @map("sale_status")
  version       Int               @default(0)
  inventory     Inventory?
  cartItems     CartItem[]
  orderItems    OrderItem[]
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([shopId, skuNormalized], map: "product_variants_shop_sku_key")
  @@unique([productId, attributesKey], map: "product_variants_product_attributes_key")
  @@unique([id, shopId], map: "product_variants_id_shop_id_key")
  @@index([productId, saleStatus, price, id], map: "product_variants_product_status_price_id_idx")
  @@map("product_variants")
}

model Inventory {
  variantId         String              @id @map("variant_id") @db.Uuid
  shopId            String              @map("shop_id") @db.Uuid
  variant           ProductVariant      @relation(fields: [variantId, shopId], references: [id, shopId], onDelete: Restrict, onUpdate: Cascade)
  shop              Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  availableQuantity Int                 @default(0) @map("available_quantity")
  version           Int                 @default(0)
  movements         InventoryMovement[]
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([variantId, shopId], map: "inventory_variant_shop_id_key")
  @@index([shopId, variantId], map: "inventory_shop_variant_idx")
  @@map("inventory")
}

model InventoryMovement {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventoryId   String                @map("inventory_id") @db.Uuid
  inventory     Inventory             @relation(fields: [inventoryId], references: [variantId], onDelete: Restrict, onUpdate: Cascade)
  sellerOrderId String?               @map("seller_order_id") @db.Uuid
  orderItemId   String?               @map("order_item_id") @db.Uuid
  actorUserId   String?               @map("actor_user_id") @db.Uuid
  actor         User?                 @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  shopId        String?               @map("shop_id") @db.Uuid
  shop          Shop?                 @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sellerOrder   SellerOrder?          @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orderItem     OrderItem?            @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  kind          InventoryMovementKind
  effectType    InventoryEffectType?  @map("effect_type")
  quantityDelta Int                   @map("quantity_delta")
  quantityAfter Int                   @map("quantity_after")
  reason        String?               @db.VarChar(500)
  operationKey  String                @unique(map: "inventory_movements_operation_key_key") @map("operation_key") @db.VarChar(160)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([orderItemId, effectType], map: "inventory_movements_order_item_effect_key")
  @@index([inventoryId, createdAt, id], map: "inventory_movements_inventory_created_id_idx")
  @@map("inventory_movements")
}

model Cart {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyerUserId String     @unique(map: "carts_buyer_user_id_key") @map("buyer_user_id") @db.Uuid
  buyer       User       @relation(fields: [buyerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  version     Int        @default(0)
  items       CartItem[]
  quotes      CheckoutQuote[]
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("carts")
}

model CartItem {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String         @map("cart_id") @db.Uuid
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variantId String         @map("variant_id") @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  quantity  Int
  selected  Boolean        @default(true)
  version   Int            @default(0)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([cartId, variantId], map: "cart_items_cart_variant_key")
  @@index([cartId, selected, id], map: "cart_items_cart_selected_id_idx")
  @@map("cart_items")
}

model CheckoutQuote {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyerUserId       String            @map("buyer_user_id") @db.Uuid
  buyer             User              @relation(fields: [buyerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cartId            String            @map("cart_id") @db.Uuid
  cart              Cart              @relation(fields: [cartId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cartVersion       Int               @map("cart_version")
  selectedItems     Json              @map("selected_items_snapshot") @db.JsonB
  addressId         String            @map("address_id") @db.Uuid
  address           Address           @relation(fields: [addressId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recipientSnapshot Json              @map("recipient_snapshot") @db.JsonB
  paymentMethod     PaymentMethod     @map("payment_method")
  total             Decimal           @db.Decimal(18, 0)
  canonicalHash     String            @map("canonical_hash") @db.Text
  expiresAt         DateTime          @map("expires_at") @db.Timestamptz(6)
  consumedOrderId   String?           @unique(map: "checkout_quotes_consumed_order_id_key") @map("consumed_order_id") @db.Uuid
  consumedOrder     MarketplaceOrder? @relation(fields: [consumedOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([buyerUserId, expiresAt, id], map: "checkout_quotes_buyer_expiry_id_idx")
  @@index([expiresAt], map: "checkout_quotes_expires_at_idx")
  @@map("checkout_quotes")
}

model MarketplaceOrder {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyerUserId       String                  @map("buyer_user_id") @db.Uuid
  buyer             User                    @relation(fields: [buyerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  publicNumber      String                  @unique(map: "marketplace_orders_public_number_key") @map("public_number") @db.VarChar(32)
  recipientSnapshot Json                    @map("recipient_snapshot") @db.JsonB
  paymentMethod     PaymentMethod           @map("payment_method")
  originalTotal     Decimal                 @map("original_total") @db.Decimal(18, 0)
  shippingTotal     Decimal                 @default(0) @map("shipping_total") @db.Decimal(18, 0)
  paymentDeadline   DateTime?               @map("payment_deadline") @db.Timestamptz(6)
  status            MarketplaceOrderStatus @default(PENDING)
  version           Int                     @default(0)
  sellerOrders      SellerOrder[]
  payment           Payment?
  quote             CheckoutQuote?
  events            OrderEvent[]
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([buyerUserId, createdAt, id], map: "marketplace_orders_buyer_created_id_idx")
  @@index([paymentMethod, paymentDeadline, id], map: "marketplace_orders_payment_deadline_idx")
  @@map("marketplace_orders")
}

model SellerOrder {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId            String            @map("order_id") @db.Uuid
  order              MarketplaceOrder  @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  shopId             String            @map("shop_id") @db.Uuid
  shop               Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  shopNameSnapshot   String            @map("shop_name_snapshot") @db.VarChar(150)
  status             SellerOrderStatus @default(PENDING)
  originalTotal      Decimal           @map("original_total") @db.Decimal(18, 0)
  cancelledAt        DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String?           @map("cancellation_reason") @db.VarChar(500)
  completedAt        DateTime?         @map("completed_at") @db.Timestamptz(6)
  stockReturnedAt    DateTime?         @map("stock_returned_at") @db.Timestamptz(6)
  version            Int               @default(0)
  items              OrderItem[]
  movements          InventoryMovement[]
  events             OrderEvent[]
  paymentAllocations PaymentAllocation[]
  refunds            SimulatedRefund[]
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([orderId, shopId], map: "seller_orders_order_shop_key")
  @@unique([id, shopId], map: "seller_orders_id_shop_key")
  @@index([shopId, status, createdAt, id], map: "seller_orders_shop_status_created_id_idx")
  @@index([shopId, completedAt, id], map: "seller_orders_shop_completed_id_idx")
  @@map("seller_orders")
}

model OrderItem {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerOrderId       String             @map("seller_order_id") @db.Uuid
  shopId              String             @map("shop_id") @db.Uuid
  sellerOrder         SellerOrder        @relation(fields: [sellerOrderId, shopId], references: [id, shopId], onDelete: Restrict, onUpdate: Cascade)
  productId           String             @map("product_id") @db.Uuid
  product             Product            @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Restrict, onUpdate: Cascade)
  variantId           String             @map("variant_id") @db.Uuid
  variant             ProductVariant     @relation(fields: [variantId, shopId], references: [id, shopId], onDelete: Restrict, onUpdate: Cascade)
  productNameSnapshot String             @map("product_name_snapshot") @db.VarChar(200)
  skuSnapshot         String             @map("sku_snapshot") @db.VarChar(100)
  attributesSnapshot  Json               @map("attributes_snapshot") @db.JsonB
  imageAssetId        String?            @map("image_asset_id") @db.Uuid
  imageAsset          Asset?             @relation(fields: [imageAssetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  imageKeySnapshot    String?            @map("image_key_snapshot") @db.Text
  unitPrice           Decimal            @map("unit_price") @db.Decimal(18, 0)
  quantity            Int
  lineTotal           Decimal            @map("line_total") @db.Decimal(18, 0)
  movements           InventoryMovement[]
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([sellerOrderId, variantId], map: "order_items_seller_variant_key")
  @@index([productId, id], map: "order_items_product_id_idx")
  @@map("order_items")
}

model OrderEvent {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String            @map("order_id") @db.Uuid
  order         MarketplaceOrder  @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sellerOrderId String?           @map("seller_order_id") @db.Uuid
  sellerOrder   SellerOrder?      @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorUserId   String?           @map("actor_user_id") @db.Uuid
  actorUser     User?             @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorKind     String            @map("actor_kind") @db.Text
  action        String            @db.Text
  fromStatus    String?           @map("from_status") @db.Text
  toStatus      String?           @map("to_status") @db.Text
  reason        String?           @db.Text
  operationKey  String            @unique(map: "order_events_operation_key_key") @map("operation_key") @db.VarChar(160)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderId, createdAt, id], map: "order_events_order_created_id_idx")
  @@index([sellerOrderId, createdAt, id], map: "order_events_seller_created_id_idx")
  @@map("order_events")
}

model Payment {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String          @unique(map: "payments_order_id_key") @map("order_id") @db.Uuid
  order     MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  method    PaymentMethod
  currency  String          @default("VND") @db.Char(3)
  version   Int             @default(0)
  attempts  PaymentAttempt[]
  events    PaymentEvent[]
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("payments")
}

model PaymentAttempt {
  id                         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId                  String                 @map("payment_id") @db.Uuid
  payment                    Payment                @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attemptNumber              Int                    @map("attempt_number")
  provider                   PaymentProvider
  settlementKind             PaymentSettlementKind  @default(NORMAL) @map("settlement_kind")
  originalAttemptId          String?                @map("original_attempt_id") @db.Uuid
  originalAttempt            PaymentAttempt?        @relation("PaymentAttemptChain", fields: [originalAttemptId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  compensationAttempts       PaymentAttempt[]       @relation("PaymentAttemptChain")
  compensatesEventId         String?                @unique(map: "payment_attempts_compensates_event_id_key") @map("compensates_event_id") @db.Uuid
  compensatesEvent           PaymentEvent?          @relation("LateCompensationSource", fields: [compensatesEventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  status                     PaymentAttemptStatus   @default(PENDING)
  targetSellerOrdersSnapshot Json                   @map("target_seller_orders_snapshot") @db.JsonB
  amount                     Decimal                @db.Decimal(18, 0)
  externalTransactionId      String?                @map("external_transaction_id") @db.VarChar(160)
  expiresAt                  DateTime?              @map("expires_at") @db.Timestamptz(6)
  settledAt                  DateTime?              @map("settled_at") @db.Timestamptz(6)
  operationKey               String                 @unique(map: "payment_attempts_operation_key_key") @map("operation_key") @db.VarChar(160)
  allocations                PaymentAllocation[]
  events                     PaymentEvent[]         @relation("PaymentAttemptEvents")
  createdAt                  DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([paymentId, attemptNumber], map: "payment_attempts_payment_number_key")
  @@index([paymentId, status, createdAt], map: "payment_attempts_payment_status_created_idx")
  @@map("payment_attempts")
}

model PaymentAllocation {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId      String                @map("attempt_id") @db.Uuid
  attempt        PaymentAttempt        @relation(fields: [attemptId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sellerOrderId  String                @map("seller_order_id") @db.Uuid
  sellerOrder    SellerOrder           @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  amount         Decimal               @db.Decimal(18, 0)
  kind           PaymentAllocationKind
  refund         SimulatedRefund?
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([attemptId, sellerOrderId], map: "payment_allocations_attempt_seller_key")
  @@index([sellerOrderId, id], map: "payment_allocations_seller_id_idx")
  @@map("payment_allocations")
}

model SimulatedRefund {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  allocationId  String               @unique(map: "simulated_refunds_allocation_id_key") @map("allocation_id") @db.Uuid
  allocation    PaymentAllocation    @relation(fields: [allocationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sellerOrderId String               @map("seller_order_id") @db.Uuid
  sellerOrder   SellerOrder          @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  amount        Decimal              @db.Decimal(18, 0)
  reason        SimulatedRefundReason
  status        String               @default("SUCCEEDED") @db.Text
  operationKey  String               @unique(map: "simulated_refunds_operation_key_key") @map("operation_key") @db.VarChar(160)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([sellerOrderId, createdAt, id], map: "simulated_refunds_seller_created_id_idx")
  @@map("simulated_refunds")
}

model PaymentEvent {
  id                           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId                    String                 @map("payment_id") @db.Uuid
  payment                      Payment                @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attemptId                    String?                @map("attempt_id") @db.Uuid
  attempt                      PaymentAttempt?        @relation("PaymentAttemptEvents", fields: [attemptId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  compensationAttempt          PaymentAttempt?        @relation("LateCompensationSource")
  provider                     PaymentProvider
  externalEventId              String                 @map("external_event_id") @db.VarChar(160)
  payloadDigest                String                 @map("payload_digest") @db.Char(64)
  observedStatus               PaymentObservedStatus  @map("observed_status")
  processingResult             PaymentEventResult     @map("processing_result")
  lateReceivedAmount           Decimal?               @map("late_received_amount") @db.Decimal(18, 0)
  lateReceivedTransactionId    String?                @map("late_received_transaction_id") @db.VarChar(160)
  receivedAt                   DateTime               @default(now()) @map("received_at") @db.Timestamptz(6)

  @@unique([provider, externalEventId], map: "payment_events_provider_external_event_key")
  @@index([paymentId, receivedAt, id], map: "payment_events_payment_received_id_idx")
  @@map("payment_events")
}
