{
  "name": "@marketplace/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "file-type": "^22.2.0",
    "jose": "^6.2.13",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.18",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "dotenv": "18.0.3",
    "eslint": "catalog:",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "typescript": "catalog:",
    "yaml": "2.9.1"
  },
  "scripts": {
    "build": "pnpm prisma:generate && tsc --project tsconfig.build.json",
    "lint": "node ../../packages/config/lint.mjs",
    "start": "node dist/main.js",
    "typecheck": "pnpm prisma:generate && node ../../packages/config/typecheck.mjs",
    "test": "node scripts/run-tests.mjs unit",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:contracts": "node scripts/run-tests.mjs contracts",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:dev": "node scripts/prisma-migrate.mjs dev",
    "prisma:migrate:deploy": "node scripts/prisma-migrate.mjs deploy",
    "prisma:migrate:status": "node scripts/prisma-migrate.mjs status",
    "prisma:schema:check": "node scripts/prisma-schema-check.mjs",
    "seed:identity": "node --experimental-strip-types prisma/seed/identity.seed.ts",
    "seed:shops": "node --experimental-strip-types prisma/seed/shops.seed.ts"
  }
}
