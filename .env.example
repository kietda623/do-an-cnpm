# Copy this file to .env for local development. Keep real values out of Git.
NODE_ENV=development

# Host process connects through localhost. Inside Compose, use the postgres service name:
# DATABASE_URL=postgresql://marketplace:CHANGE_ME@postgres:5432/marketplace?schema=public
DATABASE_URL=postgresql://marketplace:CHANGE_ME@localhost:5432/marketplace?schema=public
API_PORT=4000

# Generate a new signing secret for each local environment. Keep the previous key only
# while rotating keys; it is verification-only and may be empty for a fresh environment.
JWT_SIGNING_SECRET=
JWT_PREVIOUS_SECRET=
ACCESS_TOKEN_TTL=10m
REFRESH_SESSION_TTL=7d

# Use only public origins/URLs here. For a physical mobile device, replace localhost
# with the development machine's reachable LAN address or an HTTPS endpoint.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:8081
PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Configure these only when an S3-compatible development bucket is available.
# Keep access credentials server-side; never use NEXT_PUBLIC_ or EXPO_PUBLIC_ prefixes.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_READ_BASE=

MOCK_PAYMENT_TTL=15m
LOG_LEVEL=info

# Seed bootstrap credentials are optional and must be set deliberately for a disposable
# local environment. Leave blank otherwise; never reuse them outside local development.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
