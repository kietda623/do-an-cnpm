# Copy this file to .env for local development. Keep real values out of Git.
NODE_ENV=development

# Local PostgreSQL database. Set your PostgreSQL password in the ignored .env file;
# URL-encode reserved characters in the password (for example, @ becomes %40).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/cnpm?schema=public
API_PORT=4000

# Generate a new signing secret for each local environment. Keep the previous key only
# while rotating keys; it is verification-only and may be empty for a fresh environment.
JWT_SIGNING_SECRET=
JWT_PREVIOUS_SECRET=
ACCESS_TOKEN_TTL=10m
REFRESH_SESSION_TTL=7d

# Shared authentication rate limits. Start the Compose Redis service for local source runs.
RATE_LIMIT_REDIS_URL=redis://localhost:56379
# Generate a separate random value of at least 32 characters before starting the API.
RATE_LIMIT_KEY_SECRET=
RATE_LIMIT_KEY_PREFIX=marketplace-local
API_TRUST_PROXY_HOPS=0
RATE_LIMIT_REGISTER_EMAIL_PER_MINUTE=5
RATE_LIMIT_REGISTER_IP_PER_MINUTE=60
RATE_LIMIT_LOGIN_EMAIL_PER_MINUTE=10
RATE_LIMIT_LOGIN_IP_PER_MINUTE=180
RATE_LIMIT_REFRESH_FAMILY_PER_MINUTE=30
RATE_LIMIT_REFRESH_IP_PER_MINUTE=300

# Local web origins allowed by the API. The Windows desktop demo uses the same
# storefront origin. Do not add tauri://localhost.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002
PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Configure these only when an S3-compatible development bucket is available.
# Keep access credentials server-side; never use public prefixes.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_READ_BASE=
# Without S3, development stores uploads on disk and serves them from
# PUBLIC_API_URL/api/v1/assets. Production still requires S3.
ASSET_LOCAL_DIR=
ASSET_PUBLIC_READ_BASE=

MOCK_PAYMENT_TTL=15m
LOG_LEVEL=info

# Seed bootstrap credentials are optional and must be set deliberately for a disposable
# local environment. Leave blank otherwise; never reuse them outside local development.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
