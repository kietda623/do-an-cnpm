{
  "name": "do-an-cnpm",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "eslint .",
    "lint:workspaces": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"apps/**/*.{js,jsx,ts,tsx,mjs,cjs,json}\" \"packages/**/*.{js,jsx,ts,tsx,mjs,cjs,json}\" \"packages/config/*.mjs\" \"eslint.config.mjs\" \"package.json\" \"pnpm-workspace.yaml\" \"turbo.json\"",
    "format:check": "prettier --check \"apps/**/*.{js,jsx,ts,tsx,mjs,cjs,json}\" \"packages/**/*.{js,jsx,ts,tsx,mjs,cjs,json}\" \"packages/config/*.mjs\" \"eslint.config.mjs\" \"package.json\" \"pnpm-workspace.yaml\" \"turbo.json\"",
    "test": "turbo run test",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:admin": "playwright test --config=playwright.admin.config.ts",
    "test:e2e:seller": "playwright test --config=playwright.seller.config.ts",
    "test:e2e:catalog": "playwright test --config=playwright.catalog.config.ts",
    "test:e2e:discovery": "playwright test --config=playwright.discovery.config.ts",
    "test:e2e:checkout": "playwright test --config=playwright.checkout.config.ts",
    "clean": "turbo run clean",
    "test:e2e:fulfillment": "pnpm --filter @marketplace/api build && playwright test --config=playwright.fulfillment.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "6.0.3"
  }
}
