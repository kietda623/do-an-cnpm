{
  "name": "@marketplace/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./auth/types": "./src/auth/types.ts",
    "./auth/web-session": "./src/auth/web-session.ts",
    "./auth/expo-session": "./src/auth/expo-session.ts"
  },
  "scripts": {
    "generate:types": "openapi-typescript ../contracts/openapi.yaml -o src/generated/index.ts && prettier --write src/generated/index.ts",
    "lint": "node ../../packages/config/lint.mjs",
    "test": "node --experimental-strip-types --test test/transport.test.ts test/expo-session.test.ts",
    "typecheck": "node ../../packages/config/typecheck.mjs"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "openapi-typescript": "7.13.0",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
